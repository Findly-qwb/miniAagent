# 需要把 API Key 配置为环境变量，而不是硬编码在代码里
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# 上下文窗口 token 上限（估算值），超过时自动摘要压缩旧消息（Todo1-2）
MAX_CONTEXT_TOKENS=4000

# Todo1-4：PostgreSQL + pgvector 与 embedding 配置
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your-pg-password
PG_DATABASE=miniagent
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_DIM=768
