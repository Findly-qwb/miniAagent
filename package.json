{
  "name": "miniagent",
  "version": "1.0.0",
  "description": "最小 OpenAI Agent 示例（Function Calling）",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "server": "tsx src/server/index.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "start": "node dist/server/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/eval-rag.ts",
    "eval:agent": "tsx scripts/eval-agent.ts"
  },
  "keywords": [
    "openai",
    "agent",
    "function-calling"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.5.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "openai": "^4.77.0",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  }
}
